# Где работают модели: ollama (локально, по умолчанию) | openai (внешний API) | fake (офлайн-заглушка)
LLM_PROVIDER=ollama

# --- Локально через Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1
CHEAP_MODEL=qwen2.5:3b        # триаж: быстрая маленькая модель
STRONG_MODEL=qwen2.5:7b       # tool-calling и план; альтернатива: llama3.1:8b
LLM_TIMEOUT=300               # секунд на запрос, на CPU ответы медленные

# --- Внешний API (когда появится бюджет) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHEAP_MODEL=gpt-4o-mini
# STRONG_MODEL=gpt-4o

REVIEW_THRESHOLD=0.7
MAX_TOOL_STEPS=4
